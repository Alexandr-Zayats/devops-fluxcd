          "editorMode": "code",
          "expr": "sum by (namespace, service) (\n  label_replace(\n    increase(\n      kube_pod_container_status_restarts_total{\n        namespace=~\"$${env}-(api|cms|frontend|services)\",\n        pod!~\".*prometheus.*|.*kube-state.*|.*migration.*|.*job.*\"\n      }[1h]\n    ),\n    \"service\", \"$1\", \"pod\",\n    \"^([a-z0-9][a-z0-9.-]+[a-z0-9])-[a-z0-9]{5,10}-[a-z0-9]{5}$\"\n  )\n) > -1\nor\nsum by (namespace, service) (\n  label_replace(\n    increase(\n      kube_pod_container_status_restarts_total{\n        namespace=~\"$${env}-(api|cms|frontend|services)\",\n        pod!~\".*prometheus.*|.*kube-state.*|.*migration.*|.*job.*\"\n      }[1h]\n    ),\n    \"service\", \"$1\", \"pod\",\n    \"^([a-z0-9][a-z0-9-]+)-[0-9]+$\"\n  )\n) > -1\nor\nsum by (namespace, service) (\n  label_replace(\n    increase(\n      kube_pod_container_status_restarts_total{\n        namespace=~\"$${env}-(api|cms|frontend|services)\",\n        pod!~\".*prometheus.*|.*kube-state.*|.*migration.*|.*job.*\"\n      }[1h]\n    ),\n    \"service\", \"$1\", \"pod\",\n    \"^([a-z0-9][a-z0-9.-]+[a-z0-9])-[0-9]+-[a-z0-9]+$\"\n  )\n) > -1",
