      "description": "Total restart counts of all pods in service $service.\nBased on kube_pod_container_status_restarts_total",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#ff0e2a",
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": -100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "dark-green",
                "value": 0.9
              },
              {
                "color": "dark-red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 1
